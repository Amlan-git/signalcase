{
  "name": "signalcase",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "scripts": {
    "contracts:generate": "json2ts -i contracts/signalcase.schema.json -o packages/contracts/typescript/src/generated.ts --bannerComment '/* Generated from contracts/signalcase.schema.json. Do not edit directly. */'",
    "contracts:check": "npm run contracts:generate && git diff --exit-code -- packages/contracts/typescript/src/generated.ts",
    "lint": "eslint eslint.config.mjs tests/node tests/typescript packages/contracts/typescript/src",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/node/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.15",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.10.0",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
