{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "packages/contracts/typescript/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/typescript/**/*.ts",
    "eslint.config.mjs"
  ]
}
